# No keys required for public Wikipedia/Crossref search or optional demo mode.
# Copy to .env; never commit real credentials.
APP_HOST=127.0.0.1
APP_PORT=8080
# Required if APP_HOST is not loopback. Browser HTTP Basic login accepts any username.
APP_ACCESS_TOKEN=
# Hosts accepted by the web server, not crawling targets. Add deployment hostname explicitly.
APP_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional paid integrations. Without Brave, live search uses public indexes.
BRAVE_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
OPENAI_API_KEY=
# Set an available Responses API model from your own account before enabling RAG.
OPENAI_MODEL=
# Only full HTML crawling uses this list; search results/source links are not restricted to it.
# No private/local IPs may be fetched.
FETCH_ALLOWED_HOSTS=huggingface.co,docs.pytorch.org,pytorch.org,arxiv.org,docs.langchain.com,python.langchain.com,developers.openai.com,platform.openai.com,docs.typesafe.ai
FETCH_TIMEOUT_SECONDS=8
SEARCH_TIMEOUT_SECONDS=45
MAX_CONCURRENT_SEARCHES=2
